# Copy this file to .env and fill in the values. .env is git-ignored.
# docker compose reads .env automatically.

# Used when the browser sends no key. Leave empty on a public site,
# or every visitor's requests are billed to this key.
REQUESTY_API_KEY=

# Optional. Uncomment to change the defaults.

# Upstream API, e.g. a regional endpoint.
# REQUESTY_BASE_URL=https://router.requesty.ai/v1

# For node server.js only; the Docker image sets its own.
# Listen port (or a pipe/socket path on hosts like iisnode or Passenger).
# PORT=3000
# Listen address. Use 0.0.0.0 to accept connections from other machines.
# HOST=127.0.0.1
