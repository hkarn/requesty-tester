{
  "folders": [
    { "path": "." }
  ],
  "settings": {
    "editor.tabSize": 2,
    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true,
    "files.exclude": {
      "**/node_modules": true
    }
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Run server",
        "type": "node",
        "request": "launch",
        "program": "${workspaceFolder}/server.js",
        "console": "integratedTerminal",
        "serverReadyAction": {
          "pattern": "running at (https?://\\S+)",
          "uriFormat": "%s",
          "action": "openExternally"
        }
      }
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Start server",
        "type": "shell",
        "command": "node server.js",
        "isBackground": true,
        "problemMatcher": []
      },
      {
        "label": "Docker: compose up (build from source)",
        "type": "shell",
        "command": "docker compose up --build",
        "problemMatcher": []
      },
      {
        "label": "Docker: compose down",
        "type": "shell",
        "command": "docker compose down",
        "problemMatcher": []
      }
    ]
  },
  "extensions": {
    "recommendations": [
      "anthropic.claude-code",
      "ms-azuretools.vscode-docker",
      "github.vscode-github-actions"
    ]
  }
}
